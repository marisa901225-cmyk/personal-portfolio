# Base image with pre-compiled heavy dependencies.
# Build through scripts/build-backend-image.sh --refresh-base.
FROM python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install build dependencies + backup utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libstdc++6 \
    curl \
    ca-certificates \
    sqlite3 \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Pre-install heavy/compiled dependencies (cached in base image)
RUN pip install --no-cache-dir \
    pandas==2.3.1 \
    scikit-learn \
    llama-cpp-python==0.3.16 \
    sentence-transformers==2.2.2 \
    faiss-cpu
